# Copy to .env in the repo root (setup_server.sh does it) and fill in. Never commit .env.

# Turns off .env loading in core/settings.py (docker compose passes these values itself)
ENV=production

# Not released bots to start too, comma separated: coin_angel, b2bro
COMPOSE_PROFILES=

# Anabelle (@AnabelleBot)
TELEGRAM_BOT_TOKEN=
GITHUB_TOKEN=
# Concerts (free key from developer.ticketmaster.com)
TICKETMASTER_API_KEY=

# Coin Angel (@AngelCoin_Bot); MONGO_URI is set in docker-compose.yml
TELEGRAM_ANGEL_TOKEN=
ANGELA_TELEGRAM_USERID=

# B2Bro
TELEGRAM_B2Bro_TOKEN=
OPENAI_API_KEY=
